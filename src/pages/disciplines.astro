---
import Layout from '../layouts/Layout.astro';

const disciplines = [
  {
    title: 'Structural Engineering',
    desc: 'From protective structures to high-rise, temporary works to CBD towers.',
    icon: 'M4 10h6v11H4zM14 4h6v17h-6zM2 21h20',
  },
  {
    title: 'Civil Engineering',
    desc: 'Roads, bridges and civil infrastructure, from principal to graduate level.',
    icon: 'M2 21c4-14 16-14 20 0M12 7v4M12 14v2',
  },
  {
    title: 'Rail & Transport Infrastructure',
    desc: 'Metro, rail and transport delivery teams, from design through construction.',
    icon: 'M4 3h16v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM4 12h16M8 19l-1.4 3M16 19l1.4 3',
  },
  {
    title: 'Water & Environmental',
    desc: 'Technical specialists across water, environmental and utilities work.',
    icon: 'M12 2s7 7.5 7 12.5a7 7 0 1 1-14 0C5 9.5 12 2 12 2z',
  },
  {
    title: 'Drafting & BIM',
    desc: 'REVIT and structural drafting talent, from technician to lead drafter.',
    icon: 'M9 11l-6 6 3 3 6-6M14 4l6 6-3 3-6-6 3-3zM6 17l2 2',
  },
  {
    title: 'Project & Program Management',
    desc: 'Directors and associate directors leading complex, high-value delivery.',
    icon: 'M6 3h12v18H6zM9 8h6M9 13l2 2 4-4',
  },
];
---

<Layout title="Disciplines" description="ConstructEng Australia recruits across structural engineering, civil engineering, rail and transport infrastructure, water, drafting and project management.">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Disciplines</span>
      <h1>Where we recruit.</h1>
      <p class="lead">Deep networks across the technical disciplines behind Australia's major building and civil projects — for both permanent and contract roles.</p>
      <div class="grid">
        {disciplines.map((d) => (
          <div class="card">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={`<path d="${d.icon}"></path>`} />
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
          </div>
        ))}
      </div>
      <div class="cta-row">
        <a href="/job-seekers" class="btn">See Current Vacancies</a>
        <a href="/contact#cv" class="btn btn-outline">Register Your Interest</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  h1 {
    font-size: clamp(28px, 4vw, 34px);
    margin-top: 12px;
  }
  .lead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--navy);
    max-width: 640px;
    margin-top: 14px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--line);
    margin-top: 44px;
  }
  .card {
    background: var(--paper);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card svg {
    color: var(--accent-dark);
  }
  .card h3 {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 17px;
  }
  .card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--steel);
  }
  .cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 48px;
  }
</style>
