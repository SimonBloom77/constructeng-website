---
import Layout from '../layouts/Layout.astro';

// The STARselect app runs on its own address: app.constructeng.com.au when
// the site is built, the local app with `npm run dev`. PUBLIC_STARSELECT_URL
// overrides both.
const appUrl = (import.meta.env.PUBLIC_STARSELECT_URL || (import.meta.env.DEV ? 'http://localhost:3000' : 'https://app.constructeng.com.au')).replace(/\/+$/, '');
const signUp = `${appUrl}/starselect/index.html?signup=1`;
---

<Layout title="Your STARselect Trial" description="Create your STARselect account to start your free 30-day trial.">
  <section class="section access">
    <div class="wrap">
      <span class="eyebrow">You're in</span>
      <h1>Your free trial is ready.</h1>
      <p>Thanks for registering. Create your STARselect account below to start your 30-day free trial. It takes a minute: your name, email, a password and your company name. We'll also be in touch by email from ConstructEng Australia.</p>
      <a href={signUp} target="_blank" rel="noopener" class="btn ss-btn">Create my STARselect account →</a>
      <a href="/" class="link-back">Back to Home</a>
    </div>
  </section>
</Layout>

<style>
  .access {
    text-align: center;
    padding: 64px 0;
  }
  h1 {
    font-size: clamp(28px, 4vw, 36px);
    margin: 14px 0 18px;
  }
  p {
    font-size: 16px;
    color: var(--navy);
    margin-bottom: 32px;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }
  .link-back {
    display: block;
    margin-top: 22px;
    font-size: 14px;
    color: var(--steel);
    text-decoration: none;
  }
  .link-back:hover {
    color: var(--accent-dark);
  }
</style>
