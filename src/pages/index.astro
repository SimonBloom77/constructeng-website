---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import settings from '../data/settings.json';

const allVacancies = (await getCollection('vacancies', ({ data }) => data.active))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);

const featuredTestimonials = (await getCollection('testimonials', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<Layout
  title="Construction, Engineering & Insurance Recruitment"
  description="ConstructEng Australia specialises in the recruitment of technical staff within construction, engineering and insurance, across Australia's largest building, civil and insurance sectors."
>
  <!-- Hero -->
  <section class="section section-paper hero">
    <div class="wrap hero-grid">
      <!-- STARselect first, front and centre, in its own navy and gold -->
      <aside class="ss-card" id="starselect" aria-label="STARselect">
        <div class="ss-logo">
          <svg class="ss-twinkle" viewBox="-32 -32 64 64" width="44" height="44" aria-hidden="true"><path d="M0,-32 L7,-7 L0,0 L-7,-7 Z" fill="#1E3461"/><path d="M32,0 L7,7 L0,0 L7,-7 Z" fill="#B8913B"/><path d="M0,32 L-7,7 L0,0 L7,7 Z" fill="#1E3461"/><path d="M-32,0 L-7,-7 L0,0 L-7,7 Z" fill="#B8913B"/></svg>
          <span><b>STAR</b><em>select</em></span>
        </div>
        <span class="ss-kicker">New from ConstructEng</span>
        <h2>Hire on evidence, not instinct.</h2>
        <p class="ss-motto">Minimum effort, maximum reward.</p>
        <p>Recruitment software built in-house by ConstructEng Australia. Everything for a search, in one place.</p>
        <div class="ss-offer">
          <div class="ss-box">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5h8v2M3 12h18"/></svg>
            <div><h3>Applicant tracking</h3><span>Vacancies, pipeline and candidate records, from first contact to offer. Includes intelligent messaging by email and LinkedIn, plus calls and texts from your phone.</span></div>
          </div>
          <div class="ss-box">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.6 5.6L20 9.3l-4 4 1 5.7-5-2.8-5 2.8 1-5.7-4-4 5.4-.7z"/></svg>
            <div><h3>Tailored interview guides</h3><span>Scans the CV and your role description, then writes the questions worth asking: STAR questions that test each claim against the role, with follow-up prompts and a scorecard.</span></div>
          </div>
          <div class="ss-box">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-5-5"/></svg>
            <div><h3>LinkedIn market mapping</h3><span>Searches run on your own LinkedIn, with everyone graded against the brief and messaged when you're ready.</span></div>
          </div>
          <div class="ss-box">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18h4V9H4zM10 18h4V5h-4zM16 18h4v-6h-4z"/></svg>
            <div><h3>Import, integrate and rank CVs</h3><span>Let STARselect review your applications right inside SEEK, Indeed or any ATS you use, with its browser extension. Or import the CVs from your job board. Each one is ranked against the role description, with the reasons.</span></div>
          </div>
        </div>
        <a href="/get-starselect" class="btn ss-btn ss-cta">Try STARselect free for 30 days →</a>
      </aside>
      <div class="hero-copy">
        <span class="eyebrow">Construction, Engineering &amp; Insurance Recruitment</span>
        <h1>{settings.heroHeading}</h1>
        <p class="hero-sub">{settings.heroSub}</p>
        <div class="hero-ctas">
          <a href="/job-seekers" class="btn">Browse Current Vacancies</a>
          <a href="/employers" class="btn btn-outline">Hire Through Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="section">
    <div class="wrap about-teaser">
      <div class="about-copy">
        <span class="eyebrow">About Us</span>
        <h2>25+ years of placing the people who build Australia.</h2>
        <p>{settings.aboutBio}</p>
        <a href="/about" class="link-underline">Read more about ConstructEng →</a>
      </div>
    </div>
  </section>

  <!-- Vacancies -->
  <section class="section section-paper">
    <div class="wrap">
      {allVacancies.length > 0 ? (
        <>
          <div class="section-head">
            <div>
              <span class="eyebrow">Current Vacancies</span>
              <h2>Roles we're recruiting for right now.</h2>
            </div>
            <a href="/job-seekers" class="link-underline">View all vacancies →</a>
          </div>
          <div class="vacancy-list">
            {allVacancies.map((v) => (
              <a href={`/job-seekers/${v.id}`} class="vacancy-row">
                <span class="vacancy-title">{v.data.title}</span>
                <span class="vacancy-link">View role →</span>
              </a>
            ))}
          </div>
        </>
      ) : (
        <div class="no-vacancies">
          <span class="eyebrow">Current Vacancies</span>
          <h2>No roles advertised right now.</h2>
          <p class="lead">We're always working on searches we haven't advertised yet. Send through your CV and we'll be in touch when a role matching your experience comes up.</p>
          <a href="/contact#cv" class="btn">Send Us Your CV</a>
        </div>
      )}
    </div>
  </section>

  <!-- Employers -->
  <section class="section section-ink">
    <div class="wrap">
      <span class="eyebrow accent">For Employers</span>
      <h2 class="on-dark">Hire on evidence, not instinct.</h2>
      <p class="on-dark-muted lead">Where other agencies send through numerous CVs and leave you to shortlist, we act as a recruitment consultant — managing the full hiring process so you only see candidates who genuinely fit.</p>
      <div class="employer-stats">
        <div class="employer-stat">
          <strong>{settings.statOfferRatio}</strong>
          <span class="stat-label">Submission-to-offer ratio</span>
        </div>
        <div class="employer-stat">
          <strong>{settings.statYears}</strong>
          <span class="stat-label">Relationship-led network</span>
        </div>
        <div class="employer-stat">
          <strong>Ethical</strong>
          <span class="stat-label">No re-approach guarantee</span>
        </div>
      </div>
      <a href="/contact#brief" class="btn">Start a Conversation With Simon</a>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section section-paper">
    <div class="wrap">
      <span class="eyebrow">Testimonials</span>
      <h2>What clients say.</h2>
      <div class="testimonial-grid">
        {featuredTestimonials.map((t) => (
          <div class="testimonial-card">
            <p>&ldquo;{t.data.quote}&rdquo;</p>
            <div class="testimonial-attr">
              {t.data.name !== t.data.role ? (
                <>
                  <span class="t-name">{t.data.name}</span>
                  <span class="t-company">{t.data.role}, {t.data.company}</span>
                </>
              ) : (
                <span class="t-name">{t.data.role}, {t.data.company}</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Split CTA -->
  <section class="section split-cta">
    <div class="wrap split-grid">
      <div class="split-card">
        <span class="eyebrow">Job Seekers</span>
        <h3>Looking for your next role?</h3>
        <p>Send your CV and we'll be in touch when a role matching your experience comes up — in confidence, always.</p>
        <a href="/contact#cv" class="btn">Send Us Your CV</a>
      </div>
      <div class="split-card">
        <span class="eyebrow">Employers</span>
        <h3>Need to fill a hard-to-fill role?</h3>
        <p>Tell us the brief and we'll bring you a focused shortlist of vetted, reference-checked candidates.</p>
        <a href="/contact#brief" class="btn btn-outline">Brief Us on a Role</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-inner {
    display: flex;
    gap: 56px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-copy {
    flex: 1 1 480px;
    min-width: 300px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .eyebrow.small {
    white-space: nowrap;
  }
  .eyebrow.accent {
    color: var(--on-band-accent);
  }
  .eyebrow.accent::before {
    background: var(--on-band-accent);
  }
  h1 {
    font-size: clamp(28px, 3.6vw, 42px);
  }
  .hero-sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--navy);
    max-width: 540px;
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  /* Hero: STARselect on the left, the ConstructEng introduction beside it at
     the same height. */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: stretch;
  }
  /* Less space above so both columns, STARselect's button included, fit on a laptop screen. */
  .section.hero {
    padding-top: 28px;
  }
  .hero-grid .hero-copy {
    justify-content: center;
    min-width: 0;
  }
  /* STARselect keeps its own navy and gold so it reads as a product, not
     another ConstructEng service. */
  /* A light card in STARselect's navy and gold. */
  .ss-card {
    background: #fffdf9;
    color: #1e3461;
    padding: 22px 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    border: 1px solid var(--line);
    border-top: 4px solid #b8913b;
    box-shadow: var(--shadow-md);
  }
  .ss-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 30px;
    letter-spacing: -0.01em;
  }
  .ss-logo b { font-weight: 700; color: #1e3461; }
  .ss-logo em { font-style: normal; font-weight: 700; color: #b8913b; }
  .ss-kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b8913b;
  }
  .ss-card h2 {
    color: #1e3461;
    font-size: clamp(26px, 2.5vw, 32px);
    line-height: 1.1;
    margin: 0;
  }
  .ss-card .ss-motto {
    color: #b8913b;
    font-size: clamp(18px, 1.7vw, 21px);
    font-weight: 700;
    line-height: 1.2;
    margin: -4px 0 0;
  }
  .ss-card p {
    font-size: 15px;
    line-height: 1.58;
    color: #3a4659;
    margin: 0;
  }
  /* The four things STARselect does, as boxes. */
  /* The card's trial button: as wide as the feature boxes above it. */
  .ss-card .ss-cta {
    display: flex;
    justify-content: center;
    align-self: stretch;
    width: 100%;
    box-sizing: border-box;
    font-size: 17px;
    padding: 14px 20px;
  }
  .ss-offer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin: 2px 0 6px;
  }
  .ss-box {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    background: #fbf8f1;
    border: 1px solid rgba(30, 52, 97, 0.14);
    border-radius: 10px;
    padding: 11px 12px;
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .ss-box:hover {
    border-color: rgba(184, 145, 59, 0.7);
    transform: translateY(-2px);
    box-shadow: 0 10px 22px -14px rgba(30, 52, 97, 0.35);
  }
  .ss-box svg {
    width: 22px;
    height: 22px;
    flex: none;
    margin-top: 1px;
    fill: none;
    stroke: #b8913b;
    stroke-width: 1.6;
  }
  .ss-box h3 {
    font-family: "Public Sans", sans-serif;
    font-size: 14.5px;
    font-weight: 700;
    color: #1e3461;
    margin: 0 0 3px;
    line-height: 1.3;
  }
  .ss-box span {
    display: block;
    font-size: 12px;
    line-height: 1.45;
    color: #3a4659;
  }
  /* The trial button's look is shared site-wide (.ss-btn in global.css). */
  .ss-card .ss-btn {
    align-self: flex-start;
    margin-top: auto;
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .ss-card { padding: 28px 24px; }
    .ss-offer { grid-template-columns: 1fr; }
  }


  .about-teaser {
    display: flex;
  }
  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 720px;
  }
  .about-copy h2 {
    font-size: clamp(26px, 3.5vw, 34px);
  }
  .about-copy p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--navy);
  }
  .link-underline {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
    width: fit-content;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }
  .no-vacancies {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 560px;
  }
  .no-vacancies h2 {
    font-size: clamp(26px, 3.5vw, 34px);
    margin-top: 8px;
  }
  .section-head h2 {
    font-size: clamp(26px, 3.5vw, 34px);
    margin-top: 12px;
  }

  .vacancy-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }
  .vacancy-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 20px;
    margin: 0 -20px;
    border-bottom: 1px solid var(--line);
    gap: 16px;
    text-decoration: none;
    transition: background 0.3s var(--ease), padding 0.3s var(--ease);
  }
  .vacancy-row:hover {
    background: var(--paper);
    padding-left: 28px;
    padding-right: 12px;
  }
  .vacancy-row:hover .vacancy-link {
    color: var(--accent);
  }
  .vacancy-title {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 17px;
    color: var(--ink);
  }
  .vacancy-link {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-dark);
    white-space: nowrap;
    transition: color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .vacancy-row:hover .vacancy-link {
    transform: translateX(3px);
  }

  .on-dark {
    color: var(--on-band);
    font-size: clamp(26px, 3.5vw, 34px);
    margin-top: 14px;
    max-width: 620px;
  }
  .on-dark-muted {
    color: var(--muted-on-dark);
  }
  .lead {
    font-size: 16px;
    line-height: 1.7;
    max-width: 620px;
    margin-top: 18px;
  }
  .employer-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 32px;
    margin: 28px 0;
  }
  .employer-stat {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 18px;
    border-top: 2px solid var(--on-band-accent);
  }
  .employer-stat strong {
    font-family: 'Fraunces', serif;
    font-weight: 800;
    font-size: 28px;
    color: var(--on-band);
  }
  .stat-label {
    font-size: 14px;
    color: var(--muted-on-dark);
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: var(--line);
    margin-top: 36px;
  }
  .testimonial-card {
    background: var(--card);
    padding: 36px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: relative;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .testimonial-card::before {
    content: "\201C";
    font-family: 'Fraunces', serif;
    font-size: 64px;
    line-height: 1;
    color: var(--accent-soft);
    position: absolute;
    top: 6px;
    left: 24px;
  }
  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    z-index: 1;
  }
  .testimonial-card p {
    position: relative;
    font-size: 15px;
    line-height: 1.6;
    color: var(--navy);
  }
  .testimonial-attr {
    display: flex;
    flex-direction: column;
  }
  .t-name {
    font-weight: 700;
    font-size: 14px;
    color: var(--ink);
  }
  .t-company {
    font-size: 13px;
    color: var(--steel);
  }

  .split-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .split-card {
    background: var(--card);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: background 0.35s var(--ease), transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .split-card:hover {
    background: var(--paper);
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    z-index: 1;
  }
  .split-card h3 {
    font-size: 24px;
  }
  .split-card p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--navy);
  }
</style>
