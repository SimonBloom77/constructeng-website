---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import settings from '../data/settings.json';

const featuredTestimonials = (await getCollection('testimonials', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<Layout
  title="Construction, Engineering & Insurance Recruitment"
  description="ConstructEng Australia specialises in the recruitment of technical staff within construction, engineering and insurance, across Australia's largest building, civil and insurance sectors."
>
  <!-- Hero -->
  <section class="section section-paper hero">
    <div class="wrap hero-grid">
      <!-- STARselect first, front and centre, in its own navy and gold, with STARselect Check for job seekers below it -->
      <div class="ss-col">
      <aside class="ss-card" id="starselect" aria-label="STARselect">
        <a class="ss-logo" href="/get-starselect" aria-label="STARselect: find out more">
          <svg class="ss-twinkle" viewBox="-32 -32 64 64" width="44" height="44" aria-hidden="true"><path d="M0,-32 L7,-7 L0,0 L-7,-7 Z" fill="#284278"/><path d="M32,0 L7,7 L0,0 L7,-7 Z" fill="#B8913B"/><path d="M0,32 L-7,7 L0,0 L7,7 Z" fill="#284278"/><path d="M-32,0 L-7,-7 L0,0 L-7,7 Z" fill="#B8913B"/></svg>
          <span><b>STAR</b><em>select</em></span>
        </a>
        <h2>Hire on evidence, not instinct.</h2>
        <p class="ss-motto">Minimum effort, maximum reward.</p>
        <p>Recruitment software built in-house by ConstructEng Australia. Everything for a search in one place, from applicant tracking and messaging to the interview.</p>
        <div class="ss-offer">
          <div class="ss-box">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18h4V9H4zM10 18h4V5h-4zM16 18h4v-6h-4z"/></svg>
            <div><h3>Rank applicants where they applied</h3><span>The browser extension ranks applicants inside SEEK, Indeed, LinkedIn or any ATS, or import their CVs. Each is graded against the brief, with the reason for every rating.</span></div>
          </div>
          <div class="ss-box">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-5-5M8 11l2 2 4-4"/></svg>
            <div><h3>Evidence check and pre-screen</h3><span>See how well each CV or LinkedIn profile backs up its claims, and send pre-screen questions candidates answer online, summarised for your call.</span></div>
          </div>
          <div class="ss-box">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 19c0-3.3 2.7-5 6-5s6 1.7 6 5M16 5a3 3 0 010 6M18 14c2 .6 3 2.2 3 5"/></svg>
            <div><h3>LinkedIn market maps</h3><span>Searches run on your own LinkedIn, with everyone graded against the brief and messaged when you're ready.</span></div>
          </div>
          <div class="ss-box">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.6 5.6L20 9.3l-4 4 1 5.7-5-2.8-5 2.8 1-5.7-4-4 5.4-.7z"/></svg>
            <div><h3>Tailored STAR interviews</h3><span>STAR questions that test what each CV claims, with prompts and a scorecard, plus a record of how every ranking was made.</span></div>
          </div>
        </div>
        <a href="/get-starselect" class="btn ss-btn ss-cta">Try STARselect free for 30 days →</a>
      </aside>
      <a href="/starselect-check" class="ss-seek">
        <span class="ss-seek-k"><b>STAR</b><em>select</em> Check</span>
        <span class="ss-seek-t"><strong>Thinking of applying for a job?</strong> Check your CV and LinkedIn profile against the role before you apply. →</span>
      </a>
      </div>
      <div class="hero-right">
      <div class="hero-copy">
        <span class="eyebrow">Construction, Engineering &amp; Insurance Recruitment</span>
        <h1>{settings.heroHeading}</h1>
        <p class="hero-sub">{settings.heroSub}</p>
        <div class="hero-ctas">
          <a href="/job-seekers" class="btn">Browse Current Vacancies</a>
          <a href="/employers" class="btn btn-outline">Hire Through Us</a>
        </div>
      </div>
      <!-- About us, under the introduction: it ends level with the STARselect Check box. -->
      <div class="about-copy">
        <span class="eyebrow">About Us</span>
        <h2>25+ years of placing the people who build Australia.</h2>
        <p>{settings.aboutBio}</p>
        <a href="/about" class="link-underline">Read more about ConstructEng →</a>
      </div>
      </div>
    </div>
  </section>

  <!-- Employers -->
  <section class="section section-ink">
    <div class="wrap">
      <span class="eyebrow accent">For Employers</span>
      <h2 class="on-dark">Hire on evidence, not instinct.</h2>
      <p class="on-dark-muted lead">Where other agencies send through numerous CVs and leave you to shortlist, we act as a recruitment consultant — managing the full hiring process so you only see candidates who genuinely fit.</p>
      <div class="employer-stats">
        <div class="employer-stat">
          <strong>{settings.statOfferRatio}</strong>
          <span class="stat-label">Submission-to-offer ratio</span>
        </div>
        <div class="employer-stat">
          <strong>{settings.statYears}</strong>
          <span class="stat-label">Relationship-led network</span>
        </div>
        <div class="employer-stat">
          <strong>Ethical</strong>
          <span class="stat-label">No re-approach guarantee</span>
        </div>
      </div>
      <a href="/contact#brief" class="btn">Start a Conversation With Simon</a>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section section-paper">
    <div class="wrap">
      <span class="eyebrow">Testimonials</span>
      <h2>What clients say.</h2>
      <div class="testimonial-grid">
        {featuredTestimonials.map((t) => (
          <div class="testimonial-card">
            <p>&ldquo;{t.data.quote}&rdquo;</p>
            <div class="testimonial-attr">
              {t.data.name !== t.data.role ? (
                <>
                  <span class="t-name">{t.data.name}</span>
                  <span class="t-company">{[t.data.role, t.data.company].filter(Boolean).join(', ')}</span>
                </>
              ) : (
                <span class="t-name">{[t.data.role, t.data.company].filter(Boolean).join(', ')}</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Split CTA -->
  <section class="section split-cta">
    <div class="wrap split-grid">
      <div class="split-card">
        <span class="eyebrow">Job Seekers</span>
        <h3>Looking for your next role?</h3>
        <p>Send your CV and we'll be in touch when a role matching your experience comes up — in confidence, always.</p>
        <a href="/contact#cv" class="btn">Send Us Your CV</a>
      </div>
      <div class="split-card">
        <span class="eyebrow">Employers</span>
        <h3>Need to fill a hard-to-fill role?</h3>
        <p>Tell us the brief and we'll bring you a focused shortlist of vetted, reference-checked candidates.</p>
        <a href="/contact#brief" class="btn btn-outline">Brief Us on a Role</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-inner {
    display: flex;
    gap: 45px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-copy {
    flex: 1 1 480px;
    min-width: 300px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .eyebrow.small {
    white-space: nowrap;
  }
  .eyebrow.accent {
    color: var(--on-band-accent);
  }
  .eyebrow.accent::before {
    background: var(--on-band-accent);
  }
  h1 {
    font-size: clamp(25px, 3.2vw, 37px);
  }
  .hero-sub {
    font-size: 15px;
    line-height: 1.5;
    color: var(--navy);
    max-width: 540px;
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  /* Hero: STARselect on the left, the ConstructEng introduction beside it at
     the same height. */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: stretch;
  }
  /* Less space above so both columns, STARselect's button included, fit on a laptop screen. */
  .section.hero {
    padding-top: 12px;
  }
  .hero-grid .hero-copy {
    min-width: 0;
    flex: none;
    gap: 14px;
  }
  /* The right-hand column: the introduction from the top of the STARselect card,
     About us ending level with the bottom of the STARselect Check box. */
  .hero-right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
    min-width: 0;
    padding-top: 4px;
  }
  .hero-right h1 {
    font-size: clamp(25px, 2.6vw, 33px);
  }
  .hero-right .about-copy {
    gap: 10px;
    max-width: none;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .hero-right .about-copy h2 {
    font-size: clamp(21px, 2vw, 24px);
  }
  .hero-right .about-copy p {
    font-size: 14.5px;
    line-height: 1.55;
  }
  /* STARselect keeps its own navy and gold so it reads as a product, not
     another ConstructEng service. */
  /* A light card in STARselect's navy and gold. */
  .ss-card {
    background: #fffdf9;
    color: #284278;
    padding: 22px 21px 19px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    border: 1px solid var(--line);
    border-top: 4px solid #b8913b;
    box-shadow: var(--shadow-md);
  }
  .ss-logo {
    align-self: flex-start;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 26px;
    letter-spacing: -0.01em;
  }
  .ss-logo b { font-weight: 700; color: #284278; }
  .ss-logo em { font-style: normal; font-weight: 700; color: #b8913b; }
  .ss-kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b8913b;
  }
  .ss-card h2 {
    color: #284278;
    font-size: clamp(23px, 2.2vw, 28px);
    line-height: 1.1;
    margin: 0;
  }
  .ss-card .ss-motto {
    color: #b8913b;
    font-size: clamp(16px, 1.5vw, 18px);
    font-weight: 700;
    line-height: 1.2;
    margin: -4px 0 0;
  }
  .ss-card p {
    font-size: 14px;
    line-height: 1.58;
    color: #3a4659;
    margin: 0;
  }
  /* The four things STARselect does, as boxes. */
  /* The card's trial button: as wide as the feature boxes above it. */
  .ss-card .ss-cta {
    display: flex;
    justify-content: center;
    align-self: stretch;
    width: 100%;
    box-sizing: border-box;
    font-size: 15px;
    padding: 14px 20px;
  }
  .ss-offer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin: 2px 0 6px;
  }
  .ss-box {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    background: var(--card-bg);
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    padding: 11px 12px;
    transition: transform var(--card-t), box-shadow var(--card-t), border-color var(--card-t), background var(--card-t);
  }
  .ss-box:hover {
    transform: var(--card-lift);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--card-line-hover);
    z-index: 1;
  }
  .ss-box svg {
    width: 22px;
    height: 22px;
    flex: none;
    margin-top: 1px;
    fill: none;
    stroke: #b8913b;
    stroke-width: 1.6;
  }
  .ss-box h3 {
    font-family: "Public Sans", sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    color: #284278;
    margin: 0 0 3px;
    line-height: 1.3;
  }
  .ss-box span {
    display: block;
    font-size: 12px;
    line-height: 1.45;
    color: #3a4659;
  }
  .ss-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .ss-col .ss-card {
    flex: 1;
  }
  /* STARselect Check for job seekers: a small box of its own below the STARselect card. */
  .ss-seek {
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: var(--card-bg);
    border: 1px solid var(--card-line);
    border-left: 4px solid #b8913b;
    border-radius: var(--card-radius);
    padding: 9px 14px;
    text-decoration: none;
    color: #284278;
    transition: transform var(--card-t), box-shadow var(--card-t), border-color var(--card-t);
  }
  .ss-seek:hover {
    transform: var(--card-lift);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--card-line-hover);
    border-left-color: #b8913b;
  }
  /* A heading like the STARselect name in the card above: navy, with "select" in gold. */
  .ss-seek-k {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: #284278;
  }
  .ss-seek-k b { font-weight: 700; color: #284278; }
  .ss-seek-k em { font-style: normal; font-weight: 700; color: #b8913b; }
  .ss-seek-t {
    font-size: 13px;
    line-height: 1.45;
  }
  /* The trial button's look is shared site-wide (.ss-btn in global.css). */
  .ss-card .ss-btn {
    align-self: flex-start;
    margin-top: auto;
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .ss-card { padding: 22px 19px; }
    .ss-offer { grid-template-columns: 1fr; }
  }


  .about-teaser {
    display: flex;
  }
  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 720px;
  }
  .about-copy h2 {
    font-size: clamp(23px, 3.1vw, 30px);
  }
  .about-copy p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--navy);
  }
  .link-underline {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
    width: fit-content;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 29px;
  }
  .section-head h2 {
    font-size: clamp(23px, 3.1vw, 30px);
    margin-top: 12px;
  }

  .on-dark {
    color: var(--on-band);
    font-size: clamp(23px, 3.1vw, 30px);
    margin-top: 14px;
    max-width: 620px;
  }
  .on-dark-muted {
    color: var(--muted-on-dark);
  }
  .lead {
    font-size: 15px;
    line-height: 1.6;
    max-width: 620px;
    margin-top: 18px;
  }
  .employer-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 26px;
    margin: 22px 0;
  }
  .employer-stat {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 18px;
    border-top: 2px solid var(--on-band-accent);
  }
  .employer-stat strong {
    font-family: 'Fraunces', serif;
    font-weight: 800;
    font-size: 25px;
    color: var(--on-band);
  }
  .stat-label {
    font-size: 13px;
    color: var(--muted-on-dark);
  }

  /* Six testimonials: two rows of three on a computer, one column on a phone. */
  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 29px;
  }
  .testimonial-card {
    background: var(--card-bg);
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    padding: 29px 26px 26px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: relative;
    transition: transform var(--card-t), box-shadow var(--card-t), border-color var(--card-t), background var(--card-t);
  }
  .testimonial-card::before {
    content: "\201C";
    font-family: 'Fraunces', serif;
    font-size: 56px;
    line-height: 1;
    color: var(--accent-soft);
    position: absolute;
    top: 6px;
    left: 24px;
  }
  .testimonial-card:hover {
    transform: var(--card-lift);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--card-line-hover);
    z-index: 1;
  }
  .testimonial-card p {
    position: relative;
    font-size: 14px;
    line-height: 1.5;
    color: var(--navy);
  }
  .testimonial-attr {
    display: flex;
    flex-direction: column;
  }
  .t-name {
    font-weight: 700;
    font-size: 13px;
    color: var(--ink);
  }
  .t-company {
    font-size: 13px;
    color: var(--steel);
  }

  @media (max-width: 900px) {
    .testimonial-grid {
      grid-template-columns: 1fr;
    }
  }
  .split-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
  }
  .split-card {
    background: var(--card-bg);
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform var(--card-t), box-shadow var(--card-t), border-color var(--card-t), background var(--card-t);
  }
  .split-card:hover {
    transform: var(--card-lift);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--card-line-hover);
    z-index: 1;
  }
  .split-card h3 {
    font-size: 21px;
  }
  .split-card p {
    font-size: 14px;
    line-height: 1.5;
    color: var(--navy);
  }
</style>
