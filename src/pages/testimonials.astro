---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Testimonials" description="What clients say about working with Simon Bloom and ConstructEng Australia.">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Testimonials</span>
      <h1>We are proud of the work we have done.</h1>
      <p class="lead">Here's what a few clients have had to say.</p>

      <div class="grid">
        {testimonials.map((t) => (
          <div class="card">
            <p>&ldquo;{t.data.quote}&rdquo;</p>
            <div class="attr">
              {t.data.name !== t.data.role ? (
                <>
                  <span class="t-role">{t.data.name}</span>
                  <span class="t-company">{[t.data.role, t.data.company].filter(Boolean).join(', ')}</span>
                </>
              ) : (
                <span class="t-role">{[t.data.role, t.data.company].filter(Boolean).join(', ')}</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  h1 {
    font-size: clamp(25px, 3.5vw, 30px);
    margin-top: 12px;
  }
  .lead {
    font-size: 15px;
    color: var(--navy);
    margin-top: 14px;
  }
  /* Four columns of cards, each only as tall as its own words, so there's
     less scrolling; two on a tablet, one on a phone. */
  .grid {
    columns: 4;
    column-gap: 12px;
    margin-top: 22px;
  }
  @media (max-width: 1100px) {
    .grid { columns: 2; }
  }
  @media (max-width: 640px) {
    .grid { columns: 1; }
  }
  .card {
    background: var(--card-bg);
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    padding: 22px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    break-inside: avoid;
    margin-bottom: 12px;
    transition: transform var(--card-t), box-shadow var(--card-t), border-color var(--card-t), background var(--card-t);
  }
  .card::before {
    content: "\201C";
    font-family: 'Fraunces', serif;
    font-size: 40px;
    line-height: 1;
    color: var(--accent-soft);
    position: absolute;
    top: 4px;
    left: 14px;
  }
  .card:hover {
    transform: var(--card-lift);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--card-line-hover);
    z-index: 1;
  }
  .card p {
    font-size: 13px;
    line-height: 1.5;
    color: var(--navy);
    position: relative;
  }
  .attr {
    display: flex;
    flex-direction: column;
  }
  .t-role {
    font-weight: 700;
    font-size: 12.5px;
    color: var(--ink);
  }
  .t-company {
    font-size: 12px;
    color: var(--steel);
  }
</style>
