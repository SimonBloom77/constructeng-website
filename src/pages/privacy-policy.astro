---
import Layout from '../layouts/Layout.astro';
import settings from '../data/settings.json';
const analytics = /^G-[A-Z0-9]+$/.test(String((settings as { gaId?: string }).gaId || '').trim());
---

<Layout title="Privacy Policy">
  <section class="section">
    <div class="wrap doc">
      <span class="eyebrow">Privacy Policy</span>
      <h1>How we handle your information.</h1>
      <p>ConstructEng Australia Pty Ltd ("we", "us") is committed to protecting your privacy. This policy explains how we collect, use and store personal information provided to us, including CVs and contact details submitted through this website.</p>
      <h2>What we collect</h2>
      <p>When you submit your CV or brief us on a role, we collect the information you provide — including your name, contact details, employment history and any other details included in your CV or message.</p>
      <h2>How we use it</h2>
      <p>We use this information solely to provide recruitment services: matching candidates to relevant roles, and connecting employers with suitable candidates. We do not sell your information to third parties.</p>
      {analytics && (
        <>
          <h2>Website analytics</h2>
          <p>We use Google Analytics to understand how visitors use this website, such as which pages are viewed and how people arrive here. It uses cookies and collects information such as your device, browser, approximate location and the pages you visit. It doesn't tell us who you are. The information is processed by Google, including outside Australia. You can stop it by blocking cookies in your browser or with <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">Google's opt-out add-on</a>.</p>
        </>
      )}
      <h2>Contact</h2>
      <p>For any questions about how your information is handled, contact {settings.founderName} at <a href={`mailto:${settings.email}`}>{settings.email}</a>.</p>
    </div>
  </section>
</Layout>

<style>
  .doc {
    max-width: 720px;
  }
  h1 {
    font-size: clamp(23px, 3.1vw, 28px);
    margin: 12px 0 19px;
  }
  h2 {
    font-size: 18px;
    margin: 26px 0 12px;
  }
  p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--navy);
  }
  p a {
    color: var(--accent-dark);
  }
</style>
