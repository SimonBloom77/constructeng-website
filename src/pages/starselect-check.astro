---
import Layout from '../layouts/Layout.astro';

// STARselect Check: job seekers check their own CV and LinkedIn profile.
// The account and the checks are in the STARselect app, at /check.
const appUrl = (import.meta.env.PUBLIC_STARSELECT_URL || (import.meta.env.DEV ? 'http://localhost:3000' : 'https://app.constructeng.com.au')).replace(/\/+$/, '');
const start = `${appUrl}/check`;

const what = [
  {
    title: 'Your CV against the job',
    desc: "Add the job advert or role description for a match rating out of 5, with which of its requirements your CV shows, which it only mentions, and which are missing, and what to add if you have that experience.",
  },
  {
    title: 'Your CV checked',
    desc: "Errors and inconsistencies a recruiter would query, like overlapping dates or a qualification without a year, and vague claims, with questions to help you add the missing detail.",
  },
  {
    title: 'Your LinkedIn profile checked',
    desc: 'The same check for errors and vague claims on your LinkedIn profile, with tips on the headline, the About section and roles with no description. Save your profile as a PDF on LinkedIn, or copy and paste it.',
  },
];
---

<Layout
  title="STARselect Check: check your CV against a job before you apply"
  description="STARselect Check, for job seekers: compare your CV with a job you're thinking of applying for, and check your CV or LinkedIn profile for errors and vague claims before you apply. Your first 3 checks are free."
>
  <section class="section section-paper">
    <div class="wrap ck-hero">
      <div>
        <span class="eyebrow">For job seekers</span>
        <h1>STARselect Check</h1>
        <p class="ck-tag">Thinking of applying for a job? Check your CV against the role description, and your CV or LinkedIn profile for errors, before you apply.</p>
        <p class="ck-lead">It does two things. It checks your CV against the job: download the job advert or role description, and get a match rating out of 5, with which of the role's requirements your CV shows and which are missing. And it checks your CV or your LinkedIn profile the way a recruiter reads it: errors and inconsistencies, and vague claims, with questions to help you add the missing detail.</p>
        <div class="ck-cta">
          <a href={start} class="btn ss-btn">Start free: 3 checks →</a>
          <span>No card needed.</span>
        </div>
      </div>
      <div class="ck-price">
        <h2>Price</h2>
        <p><strong>3 checks free.</strong> Then $9 a month including GST, for 30 checks a month.</p>
        <p class="ck-small">Each check counts as one: your CV, with or without a job advert, or your LinkedIn profile.</p>
      </div>
    </div>
  </section>

  <section class="section section-ink">
    <div class="wrap">
      <h2 class="ck-h2">What it checks</h2>
      <ul class="ck-cards">
        {what.map((w) => (
          <li><strong>{w.title}.</strong> {w.desc}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-paper">
    <div class="wrap ck-two">
      <div>
        <h2 class="ck-h2">Your words, not ours</h2>
        <p>STARselect Check never writes experience for you. It points to where the detail is missing and asks for it, so what you add to your CV is what you really did.</p>
      </div>
      <div>
        <h2 class="ck-h2">Your CV stays yours</h2>
        <p>STARselect doesn't save your CV, your LinkedIn profile or the feedback: it's checked, and the feedback is shown to you. See the <a href={`${appUrl}/privacy.html`} target="_blank" rel="noopener">Privacy Policy</a>.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .ck-hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 36px;
    align-items: start;
  }
  h1 {
    font-size: clamp(30px, 4vw, 42px);
    margin: 10px 0 6px;
  }
  .ck-tag {
    font-size: 18px;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.4;
    margin: 0 0 12px;
  }
  .ck-lead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--navy);
    margin: 0 0 18px;
  }
  .ck-cta {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }
  .ck-cta span {
    font-size: 14px;
    color: var(--steel);
  }
  .ck-price {
    background: var(--card-bg);
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    padding: 18px 20px;
  }
  .ck-price h2 {
    font-size: 20px;
    margin: 0 0 8px;
  }
  .ck-price p {
    font-size: 15px;
    line-height: 1.5;
    color: var(--navy);
    margin: 0 0 8px;
  }
  .ck-small {
    font-size: 13px !important;
    color: var(--steel) !important;
  }
  .ck-h2 {
    font-size: clamp(21px, 2.4vw, 26px);
    margin: 0 0 12px;
  }
  .ck-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .ck-cards li {
    background: var(--card-bg);
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    padding: 14px 16px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--navy);
    transition: transform var(--card-t), box-shadow var(--card-t), border-color var(--card-t);
  }
  .ck-cards li:hover {
    transform: var(--card-lift);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--card-line-hover);
  }
  .ck-cards strong {
    display: block;
    color: var(--ink);
    font-size: 15.5px;
    margin-bottom: 4px;
  }
  .ck-two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
  }
  .ck-two p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--navy);
    margin: 0;
  }
  @media (max-width: 900px) {
    .ck-hero,
    .ck-two,
    .ck-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
