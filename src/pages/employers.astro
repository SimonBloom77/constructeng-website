---
import Layout from '../layouts/Layout.astro';
import settings from '../data/settings.json';

const perks = [
  {
    n: '01',
    title: 'Clear timelines',
    desc: "You'll know upfront whether a search is passive, proactive, or both — and what to expect at each stage.",
  },
  {
    n: '02',
    title: 'Evidence-based screening',
    desc: 'Every candidate is assessed against the same structured criteria, not impressions.',
  },
  {
    n: '03',
    title: 'Full visibility',
    desc: 'Tracking sheets and shortlist ratings mean you always know where a search stands.',
  },
  {
    n: '04',
    title: 'Discretion when it matters',
    desc: "Sensitive and executive searches run confidentially, without your name attached until a candidate opts in.",
  },
];

const screeningCriteria = [
  'Career longevity and stability at previous employers',
  'Relevance of previous roles and employers to the position',
  'Specificity — real duties and achievements, not just job titles',
  'Qualifications, work rights, and location fit',
  'CV clarity, organisation and presentation',
  'Whether the cover letter is tailored or generic',
];

const screenTopics = [
  'Motivation & role fit',
  'Career drivers & reason for leaving',
  'Two capability questions',
  'Job-search urgency',
  'Salary expectations',
  'Notice period & planned leave',
  'Work rights',
  'Flexible-working needs',
  'Interview accommodations',
];

const existingSteps = [
  'Review previously interviewed candidates for this or adjacent roles',
  'Review previous applicants who may now be a stronger fit',
  'Ask the hiring team for names worth revisiting',
  'Check tracking spreadsheets for flagged future-interest candidates',
];

const shortlistSteps = [
  {
    n: '01',
    title: 'Build the search',
    desc: 'A dedicated project is created and targeted profiles identified across professional networks.',
  },
  {
    n: '02',
    title: 'Shortlist & rate',
    desc: 'You review each profile — a simple Good Fit / Not a Fit call — before any outreach happens.',
  },
  {
    n: '03',
    title: 'Track & share',
    desc: 'A live tracking sheet keeps you updated on progress at every stage, no chasing required.',
  },
];

const aiSteps = [
  {
    n: '01',
    title: 'AI-powered market mapping',
    desc: 'AI tools integrated with LinkedIn Recruiter help us map the market and build talent pools faster, surfacing candidates a manual search could miss.',
  },
  {
    n: '02',
    title: 'AI-assisted shortlisting',
    desc: 'AI helps us triage and prioritise applications at volume, so more of our time goes to the candidates genuinely worth a conversation.',
  },
  {
    n: '03',
    title: 'Tailored outreach, not templates',
    desc: 'AI speeds up drafting — every message is still reviewed and personalised before it goes out, never a mass template.',
  },
];

const discretionPoints = [
  'No employer name disclosed upfront',
  'NDA-protected once a candidate opts in',
  'Ideal for replacing a current incumbent discreetly',
  'Protects candidates who are currently employed',
];
---

<Layout title="For Employers" description="ConstructEng Australia's recruitment philosophy and process: a focused shortlist, a 90% submission-to-offer ratio, structured evidence-based screening, and an ethical no re-approach guarantee.">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">For Employers</span>
      <h1>Hire on evidence, not instinct.</h1>
      <p class="lead">Are you looking to recruit a new team member? We're here to help.</p>
    </div>
  </section>

  <section class="section section-paper">
    <div class="wrap two-col">
      <div>
        <h2>Recruitment Philosophy</h2>
        <p>ConstructEng Australia has a track record of successfully filling difficult assignments. We understand that there is a shortage of high quality candidates. Often it is not possible to shortlist more than one or two suitable applicants. Where other companies will send through numerous CVs, we will often only send one. We have a {settings.statOfferRatio} ratio of candidate submission to employment offer.</p>
        <p>Often recruiters will send multiple CVs and expect their client to qualify and select suitable applicants. At ConstructEng Australia we put service above everything else. By acting as a recruitment consultant, we are able to properly manage the hiring process. In the first instance we will often take references and include these on submission of the applicant's CV. This ensures that the skills and experience meet the standards and quality required for an advertised position.</p>
        <p>In many instances candidates we work with have been known to us for many years. ConstructEng Australia operates a relationship management approach to ensure regular contact is made with the people on our system.</p>
      </div>
      <div>
        <h2>Ethical Recruitment</h2>
        <p>We believe in honesty and enjoy finding outstanding candidates for our clients. There are many instances of people we have placed six or seven years ago still employed by the same company today. ConstructEng Australia promises not to approach people that have been placed by our company about new positions they may be suitable for.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">A Partnership, Not a Transaction</span>
      <h2>What you get when we work together.</h2>
      <p class="intro">Every search starts with understanding the role properly — the team, the person, and what genuinely differentiates the opportunity. From there, we run a consistent, evidence-based process so every hiring decision is backed by structured, comparable evidence rather than gut feel.</p>
      <div class="grid grid-4">
        {perks.map((p) => (
          <div class="card">
            <span class="card-num">{p.n}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-paper">
    <div class="wrap">
      <span class="eyebrow">Sourcing Strategy</span>
      <h2>Two paths — matched to your role.</h2>
      <p class="intro">The right approach depends on role seniority, market scarcity, and urgency — often, it's both at once.</p>
      <div class="path-grid">
        <div class="path-card path-dark">
          <span class="eyebrow accent-on-dark">Passive</span>
          <h3 class="on-dark">Advertise &amp; Attract</h3>
          <ul>
            <li>High-volume job boards for maximum reach and stronger shortlisting control</li>
            <li>Careers page promotion shared across professional networks</li>
            <li>Best for well-defined roles with a strong likely applicant pool</li>
          </ul>
        </div>
        <div class="path-card">
          <span class="eyebrow">Proactive</span>
          <h3>Search &amp; Headhunt</h3>
          <ul>
            <li>Direct market mapping and targeted search via professional networks</li>
            <li>Warm outreach to passive candidates who aren't actively looking</li>
            <li>Best for senior, niche, or historically hard-to-fill roles</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Screening</span>
      <h2>Rigour before a single interview happens.</h2>
      <p class="intro">Every application is assessed against a consistent lens before any conversation takes place — so the candidates you meet are genuinely worth your time.</p>
      <div class="grid grid-2">
        {screeningCriteria.map((c) => (
          <div class="tile">{c}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-ink">
    <div class="wrap">
      <span class="eyebrow accent-on-dark">Screening</span>
      <h2 class="on-dark">The structured first-round screen.</h2>
      <p class="intro on-dark-muted">Every shortlisted candidate gets the same first conversation, covering:</p>
      <div class="grid grid-3">
        {screenTopics.map((t) => (
          <div class="tile tile-dark">{t}</div>
        ))}
      </div>
      <p class="note">Preferred candidates then meet the hiring team in person, evaluated on the same structured basis.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col-wide">
      <div>
        <span class="eyebrow">Proactive Search · Step 1</span>
        <h2>Start with what already exists.</h2>
        <p class="intro">Before a single new search is run, we check what's already known:</p>
        <ol class="numbered">
          {existingSteps.map((s) => (
            <li>{s}</li>
          ))}
        </ol>
      </div>
      <div>
        <span class="eyebrow">Proactive Search · Step 2</span>
        <h2>Building the shortlist.</h2>
        <div class="stack">
          {shortlistSteps.map((s) => (
            <div class="stack-item">
              <span class="stack-num">{s.n}</span>
              <div>
                <h4>{s.title}</h4>
                <p>{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">How We Use AI</span>
      <h2>AI-assisted, still evidence-led.</h2>
      <p class="intro">We use AI to work faster — never to replace judgement. Every AI-assisted step still feeds into the same structured, evidence-based process described throughout this page.</p>
      <div class="stack">
        {aiSteps.map((s) => (
          <div class="stack-item">
            <span class="stack-num">{s.n}</span>
            <div>
              <h4>{s.title}</h4>
              <p>{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-ink">
    <div class="wrap">
      <span class="eyebrow accent-on-dark">Discretion When It Matters</span>
      <h2 class="on-dark">Confidential &amp; executive searches.</h2>
      <p class="intro on-dark-muted">For sensitive or senior appointments, discretion protects everyone involved. Target candidates are approached by an independent contact who does not disclose the engaging organisation until the candidate confirms genuine interest — at which point they're asked to sign an NDA before any further detail is shared.</p>
      <ul class="check-list">
        {discretionPoints.map((d) => (
          <li>{d}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-ink">
    <div class="wrap">
      <div class="stats-grid">
        <div class="stat">
          <strong>{settings.statOfferRatio}</strong>
          <span>Submission-to-offer ratio</span>
        </div>
        <div class="stat">
          <strong>{settings.statYears}</strong>
          <span>Relationship-led network</span>
        </div>
        <div class="stat">
          <strong>{settings.statConsultants}</strong>
          <span>Consultants at peak</span>
        </div>
        <div class="stat">
          <strong>Ethical</strong>
          <span>No re-approach guarantee</span>
        </div>
      </div>
      <a href="/contact#brief" class="btn">Brief Us on a Role</a>
    </div>
  </section>
</Layout>

<style>
  h1 {
    font-size: clamp(28px, 4vw, 34px);
    margin-top: 12px;
  }
  h2 {
    font-size: clamp(26px, 3.5vw, 36px);
    margin-top: 10px;
  }
  .lead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--navy);
    max-width: 640px;
    margin-top: 14px;
  }
  .intro {
    font-size: 16px;
    line-height: 1.65;
    color: var(--navy);
    max-width: 700px;
    margin-top: 16px;
  }
  .on-dark-muted.intro {
    color: var(--muted-on-dark);
  }
  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 48px;
  }
  .two-col h2 {
    font-size: 22px;
    margin-bottom: 16px;
    margin-top: 0;
  }
  .two-col p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--navy);
    margin-bottom: 16px;
  }

  .grid {
    display: grid;
    gap: 1px;
    background: var(--line);
    margin-top: 40px;
  }
  .grid-4 {
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }
  .grid-2 {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .grid-3 {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .card {
    background: var(--card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .section-paper .card {
    background: var(--paper);
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    z-index: 1;
  }
  .card-num {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 22px;
    color: var(--accent);
  }
  .card h3 {
    font-size: 17px;
  }
  .card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--steel);
  }

  .tile {
    background: var(--card);
    padding: 22px 24px;
    font-size: 15px;
    color: var(--navy);
    display: flex;
    align-items: center;
    transition: background 0.3s var(--ease), padding-left 0.3s var(--ease);
  }
  .section-paper .tile {
    background: var(--paper);
  }
  .tile:hover {
    background: var(--paper);
    padding-left: 30px;
  }
  .section-paper .tile:hover {
    background: var(--card);
  }
  .tile-dark {
    background: rgba(251, 248, 241, 0.5);
    color: var(--on-band);
    font-weight: 600;
    font-size: 14px;
  }
  .tile-dark:hover {
    background: rgba(251, 248, 241, 0.8);
  }

  .path-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 40px;
  }
  .path-card {
    background: var(--card);
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .path-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .path-dark {
    background: var(--band);
    color: var(--on-band);
    --muted-on-dark: var(--on-band-muted);
  }
  .accent-on-dark {
    color: var(--on-band-accent);
  }
  .accent-on-dark::before {
    background: var(--on-band-accent);
  }
  .path-card h3 {
    font-size: 22px;
  }
  .on-dark {
    color: var(--on-band);
  }
  .path-card ul {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    line-height: 1.6;
  }
  .path-dark ul {
    color: var(--muted-on-dark);
  }
  .path-card:not(.path-dark) ul {
    color: var(--navy);
  }

  .note {
    margin-top: 28px;
    font-size: 15px;
    font-style: italic;
    color: var(--on-band-accent);
  }

  .two-col-wide {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 56px;
  }
  .numbered {
    margin: 28px 0 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--navy);
  }
  .numbered li {
    padding-left: 4px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 28px;
  }
  .stack-item {
    display: flex;
    gap: 16px;
    padding: 20px;
    background: var(--paper);
    transition: background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .stack-item:hover {
    background: var(--accent-soft);
    transform: translateX(4px);
  }
  .stack-num {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 20px;
    color: var(--accent-dark);
    flex-shrink: 0;
  }
  .stack-item h4 {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 15px;
    margin: 0 0 4px;
  }
  .stack-item p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--steel);
    margin: 0;
  }

  .check-list {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px 32px;
  }
  .check-list li {
    position: relative;
    padding-left: 26px;
    font-size: 15px;
    color: var(--on-band);
  }
  .check-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 10px;
    height: 10px;
    background: var(--on-band-accent);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 28px;
    margin-bottom: 44px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 2px solid var(--on-band-accent);
  }
  .stat strong {
    font-family: 'Fraunces', serif;
    font-weight: 800;
    font-size: 26px;
    color: var(--on-band);
  }
  .stat span {
    font-size: 14px;
    color: var(--muted-on-dark);
  }
</style>
