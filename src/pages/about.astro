---
import Layout from '../layouts/Layout.astro';
import settings from '../data/settings.json';
---

<Layout title="About Us" description="ConstructEng Australia was founded by Simon Bloom in 2009 — 25+ years placing technical and executive talent across construction and engineering.">
  <section class="section">
    <div class="wrap about-grid">
      <div class="photo-frame">
        <img src="/images/simon-bloom.jpg" alt={settings.founderName} onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'photo-placeholder',textContent:'Photo — Simon Bloom'}))" />
      </div>
      <div class="copy-col">
        <span class="eyebrow">About Us</span>
        <h1>25+ years of placing the people who build Australia.</h1>
        <p>ConstructEng Australia specialises in the recruitment of technical staff within construction and engineering, offering notable roles on Australia's largest building and civil developments — for both permanent and contract positions.</p>
        <p>We are preferred suppliers to a selection of prominent international and local Australian companies, partnering with these firms to recruit their strategic, hard-to-fill positions.</p>
        <p>{settings.aboutBio}</p>
      </div>
      <div class="photo-caption">
        <strong>{settings.founderName}</strong>
        <span>{settings.founderTitle}</span>
      </div>
      <div class="stat-strip">
          <div>
            <strong>{settings.statLinkedIn}</strong>
            <span>LinkedIn network</span>
          </div>
          <div>
            <strong>{settings.statFounded}</strong>
            <span>Founded</span>
          </div>
      </div>
    </div>
    <div class="wrap">
      <div class="about-stats">
        <div class="stat-row">
          <span>Years in executive recruitment</span>
          <strong>{settings.statYears}</strong>
        </div>
        <div class="stat-row">
          <span>Candidate-submission to offer</span>
          <strong>{settings.statOfferRatio}</strong>
        </div>
        <div class="stat-row">
          <span>Focused shortlist per role</span>
          <strong>{settings.statShortlist}</strong>
        </div>
      </div>
      <a href="/contact" class="btn about-cta">Get in Touch With Simon</a>
    </div>
  </section>
</Layout>

<style>
  /* Photo beside the text; the name and title sit on the same row as the figures. */
  .about-grid {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    grid-template-areas: "photo copy" "caption stats";
    column-gap: 51px;
    row-gap: 22px;
    align-items: start;
  }
  .photo-frame {
    grid-area: photo;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--paper-2);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.photo-placeholder) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 19px;
    font-family: 'Fraunces', serif;
    font-size: 13px;
    color: var(--steel);
  }
  .photo-caption {
    grid-area: caption;
    display: flex;
    flex-direction: column;
  }
  .photo-caption strong {
    font-family: 'Fraunces', serif;
    font-weight: 800;
    font-size: 19px;
  }
  .photo-caption span {
    font-size: 13px;
    color: var(--steel);
  }
  .copy-col {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .copy-col h1 {
    font-size: clamp(25px, 3.5vw, 30px);
  }
  .copy-col p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--navy);
  }
  .stat-strip {
    grid-area: stats;
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }
  .stat-strip div {
    display: flex;
    flex-direction: column;
  }
  .stat-strip strong {
    font-family: 'Fraunces', serif;
    font-weight: 800;
    font-size: 19px;
  }
  .stat-strip span {
    font-size: 13px;
    color: var(--steel);
  }
  .about-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 38px;
  }
  .stat-row {
    background: var(--card-bg);
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    padding: 21px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    position: relative;
    transition: transform var(--card-t), box-shadow var(--card-t), border-color var(--card-t), background var(--card-t);
  }
  .stat-row:hover {
    transform: var(--card-lift);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--card-line-hover);
    z-index: 1;
  }
  .stat-row span {
    font-size: 14px;
    color: var(--navy);
    font-weight: 600;
  }
  .stat-row strong {
    font-family: 'Fraunces', serif;
    font-size: 28px;
    font-weight: 800;
    color: var(--ink);
  }
  .about-cta {
    margin-top: 26px;
  }
  @media (max-width: 900px) {
    .about-stats { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .about-grid {
      grid-template-columns: 1fr;
      grid-template-areas: "photo" "caption" "copy" "stats";
    }
    .photo-frame { width: 180px; }
  }
</style>
