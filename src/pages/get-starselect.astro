---
import Layout from '../layouts/Layout.astro';

// Sign-up happens in the STARselect app itself, so details are entered once.
// The live app is at app.constructeng.com.au; `npm run dev` uses the local
// app instead. PUBLIC_STARSELECT_URL overrides both.
const appUrl = (import.meta.env.PUBLIC_STARSELECT_URL || (import.meta.env.DEV ? 'http://localhost:3000' : 'https://app.constructeng.com.au')).replace(/\/+$/, '');
const signUp = `${appUrl}/starselect/index.html?signup=1`;
---

<Layout
  title="STARselect — STAR Interview Questions, Market Maps and CV Ranking"
  description="STARselect reviews your applications right inside your job board or ATS with its browser extension, ranks every applicant against the brief, builds ranked market maps from LinkedIn, handles the outreach and writes STAR interview questions from each CV. Try it free for 30 days."
>
  <section class="section hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <img src="/starselect-logo.svg" alt="STARselect" width="250" height="64" style="display:block;height:56px;width:auto;margin:0 0 18px;align-self:flex-start" />
        <span class="eyebrow">Introducing STARselect</span>
        <h1>Tailored STAR interview questions, straight from the CV and the brief.</h1>
        <p class="ss-motto">Hire on evidence, not instinct. Minimum effort, maximum reward.</p>
        <div class="top-cta">
          <a href={signUp} class="btn ss-btn">Start my free trial →</a>
          <span>30 days free. No card needed.</span>
        </div>
        <p class="hero-sub">One workspace for the whole search. Here's how STARselect takes a role from brief to interview:</p>
        <ol class="ss-steps">
          <li><strong>Add the role description.</strong> Upload it, or add it straight from your job ad with the STARselect browser extension. STARselect sets up the brief from it.</li>
          <li class="key"><strong>STARselect reviews your applicants live, inside your job board or ATS.</strong> With the STARselect browser extension, open an applicant in SEEK, Indeed or any ATS you use in your browser, and STARselect reads their CV and ranks them against the role on the spot. No downloading or uploading CVs. <a href="#browser-extension">See how it works</a></li>
          <li><strong>STARselect searches your LinkedIn.</strong> Connect your LinkedIn or LinkedIn Recruiter account and STARselect runs the searches and builds your market map.</li>
          <li><strong>STARselect ranks everyone.</strong> Each person is graded against the brief, with the reason shown for each criterion, and the strongest sit at the top.</li>
          <li><strong>STARselect makes contact.</strong> Personalised messages by LinkedIn or from your own email, follow-ups if there's no reply, a polite “no” for those who aren't a fit, and interview times candidates can book themselves.</li>
          <li class="key"><strong>STARselect writes each candidate's interview.</strong> It reads the candidate's CV against the role description and writes STAR questions specific to that person, testing exactly what their CV claims. Your panel gets follow-up prompts and a scorecard to print or fill in on screen.</li>
        </ol>
        <p class="hero-sub">Built in-house by ConstructEng Australia. Try it free for 30 days: see what the trial includes below.</p>
      </div>
      <div class="hero-stats">
        <div class="stat-row">
          <span>From CV and brief to</span>
          <strong>Questions</strong>
        </div>
        <div class="stat-row">
          <span>Interview method</span>
          <strong>STAR<small>Situation, Task, Action, Result</small></strong>
        </div>
        <div class="stat-row">
          <span>Market maps from</span>
          <strong>LinkedIn</strong>
        </div>
        <div class="stat-row">
          <span>Free trial</span>
          <strong>30 days</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-ink ext-sec" id="browser-extension">
    <div class="wrap">
      <span class="eyebrow">New: the STARselect browser extension</span>
      <h2>Let STARselect review your applications, right inside your job board or ATS.</h2>
      <p class="ext-lead">Add STARselect to Chrome or Edge and it works inside SEEK, Indeed, LinkedIn and any ATS you use in your browser. No downloading CVs, no uploading, no switching between systems.</p>
      <ol class="ext-steps">
        <li><strong>Open your job ad.</strong> Press Add role description to STARselect. It reads the ad and sets up the vacancy: the must-haves, the nice-to-haves and the employer.</li>
        <li><strong>Open an applicant.</strong> Right-click the page and choose Rank this page with STARselect. It reads their CV and ranks them against the role straight away.</li>
        <li><strong>See who to call first.</strong> Every applicant is scored against the must-haves, with the reason for each rating, and added to your STARselect pipeline, ready for outreach and interview questions.</li>
      </ol>
      <div class="ext-ctas">
        <a href={signUp} class="btn ss-btn">Start my free trial →</a>
        <a href={`${appUrl}/extension/starselect-extension.zip`} class="btn btn-outline" download>Download the extension</a>
      </div>
      <p class="ext-note">Included in the free trial. For Chrome and Edge on a computer.</p>
      <details class="ext-how">
        <summary>How to install it</summary>
        <ol>
          <li>Download the extension. Open your <strong>Downloads</strong> folder, right-click <strong>starselect-extension.zip</strong> and choose <strong>Extract All</strong>, then <strong>Extract</strong>. This makes a folder called <strong>starselect-extension</strong>. (On a Mac, double-click the file instead.)</li>
          <li>In Chrome, type <strong>chrome://extensions</strong> in the address bar (in Edge, <strong>edge://extensions</strong>) and turn on <strong>Developer mode</strong>.</li>
          <li>Click <strong>Load unpacked</strong>, go to your <strong>Downloads</strong> folder, click once on the <strong>starselect-extension</strong> folder and click <strong>Select Folder</strong>.</li>
          <li>Click the puzzle-piece icon in the toolbar and pin STARselect. Sign in to STARselect in the same browser, and you're ready.</li>
        </ol>
      </details>
    </div>
  </section>

  <section class="section section-paper">
    <div class="wrap trial-wrap">
      <span class="eyebrow">Free Trial</span>
      <h2>Try STARselect free for 30 days.</h2>
      <p class="lead">Create your STARselect account below and your trial starts straight away. There's nothing to pay and you don't need to enter any card details. Your trial is the Professional plan, free for a month: every feature, with Professional's full monthly allowance. Here's exactly what it includes.</p>

      <div class="trial-grid">
        <div>
          <h3>Included in your free trial</h3>
          <ul class="trial-list">
            <li><strong>30 days, for up to 3 people.</strong> Your trial starts when your account is set up and runs for 30 days. Invite up to two colleagues to share vacancies, candidates and interview guides with you, and the allowances below.</li>
            <li><strong>40 tailored interview guides.</strong> Upload a candidate's CV and the role description, and STARselect writes a complete interview guide for that person: STAR questions (Situation, Task, Action, Result) based on what their CV claims, follow-up prompts for each question, and a scorecard your interview panel can print or fill in on screen.</li>
            <li><strong>500 CVs ranked or scored against your brief.</strong> Let the STARselect browser extension review your applications right inside your job board or ATS, or drop in the CVs you've received. STARselect ranks each one against the role's must-haves and nice-to-haves, showing the reason for every rating.</li>
            <li><strong>LinkedIn market maps, up to 1,000 people.</strong> Connect your own LinkedIn or LinkedIn Recruiter account and STARselect searches LinkedIn for you, grades everyone it finds against the role and builds a ranked market map you can download to Excel. Your trial covers up to 1,000 people added to your market maps, across as many searches as you like. People the search finds who don't fit the role aren't counted.</li>
            <li><strong>Messaging candidates.</strong> Personalised messages sent on your behalf by LinkedIn, or by email from your own mailbox, with automatic follow-ups when someone hasn't replied and a polite “no” for unsuccessful applicants. STARselect marks people as Replied when they answer. On the trial, one LinkedIn account and one mailbox can be connected for your workspace, and each LinkedIn account can be used for one free trial.</li>
            <li><strong>Interview invitations.</strong> Invitations sent from your own mailbox with a calendar file attached, including a choice of times candidates can book themselves.</li>
            <li><strong>The rest of the app.</strong> The question library, ready-made interview templates, and your vacancies, pipeline and candidate records, with no limits.</li>
          </ul>
        </div>
        <div>
          <h3>On a paid plan</h3>
          <ul class="trial-list paid">
            <li><strong>Larger monthly allowances.</strong> Interview guides, CVs ranked and LinkedIn people added to market maps, with a Plus option for three times as many.</li>
            <li><strong>Your whole team.</strong> Professional is for one recruiter, Team is for 2 to 10 people, and Enterprise is for larger teams.</li>
            <li><strong>LinkedIn and email connected for everyone</strong> on your team.</li>
          </ul>
          <h3>When your trial ends</h3>
          <p class="trial-note">Everything you've saved stays in your account. STARselect's AI features, including writing interview guides, ranking CVs and searching LinkedIn, and messaging candidates, pause until you choose a plan. If you connected your LinkedIn or email during the trial, STARselect disconnects them when the trial ends, unless you've already chosen a plan. The accounts themselves aren't affected, and you can connect them again at any time on a paid plan.</p>
          <h3>Your data</h3>
          <p class="trial-note">Your data belongs to your organisation. STARselect is operated by ConstructEng Australia Pty Ltd. What you enter is stored on servers provided by a third-party host in Australia, on our behalf, and is used only to run STARselect for you. Text you send to STARselect's AI features is processed by Anthropic, and connected LinkedIn and email accounts run through Unipile; both are based overseas. We don't sell your data, and we don't use it for any other purpose, including ConstructEng Australia's own recruitment business. See the <a href={`${appUrl}/privacy.html`} target="_blank" rel="noopener">Privacy Policy</a> for details.</p>
        </div>
      </div>
    </div>
    <div class="wrap form-wrap">
      <h3 class="form-title">Start your free trial</h3>
      <p class="lead">Create your STARselect account in one step: your name, work email, a password and your company name. Your 30-day trial starts as soon as your account is created.</p>
      <a href={signUp} class="btn ss-btn start-btn">Start my free trial →</a>
    </div>
  </section>

  <section id="enquire" class="section">
    <div class="wrap form-wrap">
      <span class="eyebrow">Questions</span>
      <h2>Ask us about STARselect.</h2>
      <p class="lead">Send us your question, or ask for a walkthrough for your team. You'll get an email to confirm we've received it, and we'll reply to you directly.</p>
      <form id="ss-enquiry" class="enq-form" data-endpoint={`${appUrl}/api/enquiry`} novalidate>
        <p class="enq-hidden"><label>Leave this empty: <input name="hp" tabindex="-1" autocomplete="off" /></label></p>
        <div class="enq-grid">
          <div class="field"><label for="enq-name">Your name</label><input id="enq-name" name="name" type="text" autocomplete="name" required /></div>
          <div class="field"><label for="enq-email">Email</label><input id="enq-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="enq-company">Company</label><input id="enq-company" name="company" type="text" autocomplete="organization" /></div>
          <div class="field"><label for="enq-phone">Phone (optional)</label><input id="enq-phone" name="phone" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="field"><label for="enq-message">Your question</label><textarea id="enq-message" name="message" rows="5" required></textarea></div>
        <button type="submit" class="btn">Send my question</button>
        <p class="enq-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  // Sends the enquiry to the STARselect app (app/api/enquiry there), which
  // emails it to us and sends the enquirer an acknowledgement.
  const form = document.getElementById("ss-enquiry") as HTMLFormElement | null;
  if (form) {
    const shown = Date.now();
    const status = form.querySelector(".enq-status") as HTMLElement;
    const button = form.querySelector("button[type=submit]") as HTMLButtonElement;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (!data.name?.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email || "") || (data.message || "").trim().length < 5) {
        status.textContent = "Please add your name, a valid email address and your question.";
        return;
      }
      button.disabled = true;
      status.textContent = "Sending...";
      try {
        const r = await fetch(form.dataset.endpoint || "", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ ...data, t: shown, page: "Get STARselect page" }),
        });
        const j = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(j.error || "Your question couldn't be sent. Please try again.");
        form.reset();
        status.textContent = "Thanks, we've received your question. Check your inbox for a confirmation email.";
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : "Your question couldn't be sent. Please try again.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .enq-form {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .enq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
  }
  .enq-hidden {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .enq-form .btn {
    align-self: flex-start;
  }
  .enq-status:empty {
    display: none;
  }
  /* The browser extension: a full-width feature section in the site's camel
  (.section-ink), with ivory cards and the brown accent. */
  .ext-sec h2 {
    font-size: clamp(26px, 3.2vw, 38px);
    max-width: 820px;
    margin: 10px 0 14px;
  }
  .ext-lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--on-band-muted);
    max-width: 760px;
    margin: 0 0 28px;
  }
  .ext-steps {
    list-style: none;
    counter-reset: ext;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    padding: 0;
    margin: 0 0 28px;
  }
  .ext-steps li {
    counter-increment: ext;
    background: var(--card);
    border-top: 3px solid var(--accent);
    box-shadow: var(--shadow-md);
    padding: 20px 20px 22px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--navy);
  }
  .ext-steps li::before {
    content: counter(ext);
    display: block;
    font-family: "Fraunces", serif;
    font-size: 28px;
    font-weight: 800;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .ext-steps strong {
    display: block;
    color: var(--ink);
    font-size: 17px;
    margin-bottom: 4px;
  }
  /* On the ivory cards the wordmark is its usual navy and gold. */
  .ext-steps li :global(.ss-wm i) {
    color: #b8913b;
  }
  .ext-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .ext-note {
    font-size: 14px;
    color: var(--on-band-muted);
    margin: 12px 0 0;
  }
  .ext-how {
    margin-top: 14px;
    font-size: 14px;
    color: var(--on-band-muted);
    max-width: 760px;
  }
  .ext-how summary {
    cursor: pointer;
    color: var(--on-band-accent);
    font-weight: 600;
  }
  .ext-how ol {
    margin: 10px 0 0;
    padding-left: 20px;
    line-height: 1.7;
  }
  @media (max-width: 900px) {
    .ext-steps { grid-template-columns: 1fr; }
  }
  .ss-motto {
    color: #b8913b;
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 700;
    line-height: 1.3;
    margin: 4px 0 6px;
  }
  .hero-inner {
    display: flex;
    gap: 56px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-copy {
    flex: 1 1 480px;
    min-width: 300px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  h1 {
    font-size: clamp(24px, 3vw, 34px);
  }
  .hero-sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--navy);
    max-width: 540px;
  }
  .ss-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: 14px;
    max-width: 560px;
  }
  .ss-steps li {
    counter-increment: step;
    position: relative;
    padding-left: 44px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--navy);
  }
  .ss-steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    line-height: 28px;
    text-align: center;
  }
  .ss-steps strong {
    color: var(--ink);
  }
  /* The step STARselect is built around: the interview itself. */
  .ss-steps li.key {
    background: var(--accent-soft);
    border-radius: 8px;
    padding: 12px 14px 12px 56px;
  }
  .ss-steps li.key::before {
    left: 14px;
    top: 12px;
  }
  .hero-stats {
    flex: 1 1 360px;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--line);
    box-shadow: var(--shadow-lg);
  }
  .stat-row {
    background: var(--card);
    padding: 26px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .stat-row span {
    font-size: 15px;
    color: var(--navy);
    font-weight: 600;
  }
  .stat-row strong {
    font-family: 'Fraunces', serif;
    font-size: 32px;
    font-weight: 800;
    color: var(--ink);
    text-align: right;
  }
  .stat-row strong small {
    display: block;
    margin-top: 6px;
    font-family: 'Public Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--navy);
    text-align: right;
  }
  h2 {
    font-size: clamp(24px, 3.5vw, 30px);
    margin-top: 10px;
  }
  .lead {
    font-size: 15px;
    line-height: 1.6;
    color: var(--navy);
    max-width: 560px;
    margin-top: 12px;
  }
  .form-wrap {
    max-width: 640px;
  }
  .trial-wrap {
    max-width: 1040px;
    margin-bottom: 28px;
  }
  .trial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px 40px;
    margin-top: 28px;
  }
  .trial-grid h3 {
    font-size: 19px;
    margin: 0 0 12px;
  }
  .trial-list + h3 {
    margin-top: 22px;
  }
  .trial-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .trial-list li {
    font-size: 15px;
    line-height: 1.6;
    color: var(--navy);
    padding: 14px 16px 14px 44px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    position: relative;
  }
  .trial-list li::before {
    content: "✓";
    position: absolute;
    left: 16px;
    top: 14px;
    color: var(--accent);
    font-weight: 700;
  }
  .trial-list.paid li::before {
    content: "+";
    color: var(--steel);
  }
  .trial-list strong {
    color: var(--ink);
  }
  .trial-note {
    font-size: 15px;
    line-height: 1.6;
    color: var(--navy);
    margin: 0;
  }
  .form-title {
    font-size: 22px;
    margin: 0;
  }
  .start-btn {
    margin-top: 22px;
  }
  /* A second "Start my free trial" at the top, so it's there without scrolling. */
  .top-cta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 2px 0 4px;
  }
  .top-cta span {
    font-size: 14px;
    color: #5b6576;
  }
  .form {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
  }
  .hidden-field {
    display: none;
  }
</style>
