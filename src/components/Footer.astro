---
import settings from '../data/settings.json';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-grid">
      <div class="footer-about">
        <div class="footer-brand">
          <img src="/images/logo.png" alt={settings.companyName} width="120" />
        </div>
        <p>ConstructEng Australia Pty Ltd. Strategic recruitment in construction, engineering and insurance.</p>
      </div>
      <div class="footer-col">
        <span class="footer-heading">Contact</span>
        <span class="footer-name">{settings.founderName}</span>
        <a href={`tel:${settings.phone}`}>{settings.phoneDisplay}</a>
        <a href={`mailto:${settings.email}`}>{settings.email}</a>
        <a href={settings.linkedinUrl} target="_blank" rel="noopener">LinkedIn ↗</a>
      </div>
      <div class="footer-col">
        <span class="footer-heading">Site</span>
        <a href="/about">About Us</a>
        <a href="/job-seekers">Current Vacancies</a>
        <a href="/testimonials">Testimonials</a>
        <a href="/employers">Employers</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} ConstructEng Australia Pty Ltd. All rights reserved.</span>
      <a href="/privacy-policy">Privacy Policy</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--band);
    color: var(--on-band);
  }
  .footer-inner {
    padding: 35px 19px 19px;
  }
  .footer-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    justify-content: space-between;
  }
  .footer-about {
    max-width: 320px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .footer-brand {
    background: var(--paper);
    padding: 14px 18px;
    display: inline-flex;
    width: fit-content;
  }
  .footer-about p {
    font-size: 13px;
    line-height: 1.5;
    color: var(--on-band-muted);
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-heading {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--on-band-muted);
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .footer-name {
    font-size: 13px;
    color: var(--on-band);
    font-weight: 600;
  }
  .footer-col a {
    font-size: 13px;
    color: var(--on-band-muted);
    text-decoration: none;
  }
  .footer-col a:hover {
    color: var(--on-band);
    text-decoration: underline;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 19px;
    margin-top: 22px;
    border-top: 1px solid var(--line-band);
  }
  .footer-bottom span,
  .footer-bottom a {
    font-size: 13px;
    color: var(--on-band-muted);
    text-decoration: none;
  }
</style>
