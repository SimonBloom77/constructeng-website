---
// Not on the STARselect pages themselves, which it would only point back to.
const onStarselect = Astro.url.pathname.startsWith("/get-starselect");
---

{!onStarselect && (
<div class="app-banner" id="app-banner">
  <div class="wrap app-banner-inner">
    <!-- The whole banner leads to the STARselect page. -->
    <a class="app-banner-main" href="/get-starselect">
      <span class="app-banner-tag">New</span>
      <span class="app-banner-copy"><span class="app-banner-brand"><svg class="app-banner-mark ss-twinkle" viewBox="-32 -32 64 64" width="16" height="16" aria-hidden="true"><path d="M0,-32 L7,-7 L0,0 L-7,-7 Z" fill="#284278"/><path d="M32,0 L7,7 L0,0 L7,-7 Z" fill="#B8913B"/><path d="M0,32 L-7,7 L0,0 L7,7 Z" fill="#284278"/><path d="M-32,0 L-7,-7 L0,0 L-7,7 Z" fill="#B8913B"/></svg><span><b>STAR</b><em>select</em></span></span> <span class="ab-long">Every applicant ranked inside your job board or ATS, LinkedIn market maps, evidence checks, pre-screens and tailored STAR interviews.</span><span class="ab-short">Applicants ranked in your job board, evidence checks and tailored STAR interviews.</span></span>
    </a>
    <div class="app-banner-actions">
      <a href="/get-starselect">Start a free trial →</a>
    </div>
  </div>
</div>
)}


<style>
  .app-banner {
    background: var(--band);
    border-bottom: 1px solid var(--line-band);
    position: relative;
    overflow: hidden;
  }
  /* A gentle ripple: a soft band of light sweeps across every few seconds. */
  .app-banner::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -40%;
    width: 40%;
    background: linear-gradient(100deg, rgba(255, 253, 249, 0) 0%, rgba(255, 253, 249, 0.55) 50%, rgba(255, 253, 249, 0) 100%);
    animation: app-banner-ripple 7s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes app-banner-ripple {
    0% { transform: translateX(0); }
    45%, 100% { transform: translateX(360%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .app-banner::after { display: none; }
  }
  .app-banner-inner {
    position: relative;
    z-index: 1;
  }
  /* The full list on wide screens; a shorter line on laptops and phones, so the banner stays small. */
  .ab-short { display: none; }
  @media (max-width: 1279px) {
    .ab-long { display: none; }
    .ab-short { display: inline; }
  }
  /* STARselect's own navy and gold, on a small ivory badge so they read on camel. */
  .app-banner-brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fbf8f1;
    border-radius: 999px;
    padding: 3px 11px 3px 8px;
    margin-right: 8px;
    font-size: 13px;
    font-weight: 700;
    vertical-align: 1px;
  }
  .app-banner-brand b {
    font-weight: 700;
    color: #284278;
  }
  .app-banner-brand em {
    font-style: normal;
    color: #b8913b;
  }
  .app-banner-inner {
    padding: 11px 19px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .app-banner-main {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    color: inherit;
    text-decoration: none;
  }
  .app-banner-main:hover .app-banner-copy {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .app-banner-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fbf8f1;
    background: #284278;
    padding: 3px 8px;
    flex-shrink: 0;
  }
  .app-banner-copy {
    font-size: 13.5px;
    color: var(--on-band);
  }
  .app-banner-mark {
    flex: none;
  }
  .app-banner-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-shrink: 0;
  }
  .app-banner-actions a {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--on-band);
    text-decoration: none;
    border-bottom: 1.5px solid var(--on-band);
    padding-bottom: 1px;
    white-space: nowrap;
  }
  .app-banner-actions a:hover {
    color: #284278;
    border-color: #284278;
  }
</style>
