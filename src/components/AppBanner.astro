---
---

<div class="app-banner" id="app-banner">
  <div class="wrap app-banner-inner">
    <p>
      <span class="app-banner-tag">New</span>
      <span class="app-banner-copy"><span class="app-banner-brand"><svg class="app-banner-mark ss-twinkle" viewBox="-32 -32 64 64" width="16" height="16" aria-hidden="true"><path d="M0,-32 L7,-7 L0,0 L-7,-7 Z" fill="#1E3461"/><path d="M32,0 L7,7 L0,0 L7,-7 Z" fill="#B8913B"/><path d="M0,32 L-7,7 L0,0 L7,7 Z" fill="#1E3461"/><path d="M-32,0 L-7,-7 L0,0 L-7,7 Z" fill="#B8913B"/></svg><span><b>STAR</b><em>select</em></span></span> Tailored STAR interviews from any CV, and every applicant ranked against your brief.</span>
    </p>
    <div class="app-banner-actions">
      <a href="/get-starselect">Start a free trial →</a>
      <button type="button" id="app-banner-close" aria-label="Dismiss">&times;</button>
    </div>
  </div>
</div>

<script>
  const KEY = 'starselect-banner-dismissed';
  const banner = document.getElementById('app-banner');
  if (banner) {
    if (localStorage.getItem(KEY)) {
      banner.remove();
    } else {
      document.getElementById('app-banner-close')?.addEventListener('click', () => {
        try {
          localStorage.setItem(KEY, '1');
        } catch {}
        banner.remove();
      });
    }
  }
</script>

<style>
  .app-banner {
    background: var(--band);
    border-bottom: 1px solid var(--line-band);
  }
  /* STARselect's own navy and gold, on a small ivory badge so they read on camel. */
  .app-banner-brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fbf8f1;
    border-radius: 999px;
    padding: 3px 11px 3px 8px;
    margin-right: 8px;
    font-size: 13px;
    font-weight: 700;
    vertical-align: 1px;
  }
  .app-banner-brand b {
    font-weight: 700;
    color: #1e3461;
  }
  .app-banner-brand em {
    font-style: normal;
    color: #b8913b;
  }
  .app-banner-inner {
    padding: 11px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .app-banner-inner p {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
  }
  .app-banner-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fbf8f1;
    background: #1e3461;
    padding: 3px 8px;
    flex-shrink: 0;
  }
  .app-banner-copy {
    font-size: 13.5px;
    color: var(--on-band);
  }
  .app-banner-mark {
    flex: none;
  }
  .app-banner-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-shrink: 0;
  }
  .app-banner-actions a {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--on-band);
    text-decoration: none;
    border-bottom: 1.5px solid var(--on-band);
    padding-bottom: 1px;
    white-space: nowrap;
  }
  .app-banner-actions a:hover {
    color: #1e3461;
    border-color: #1e3461;
  }
  #app-banner-close {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
    color: var(--on-band);
    padding: 0;
    opacity: 0.7;
  }
  #app-banner-close:hover {
    opacity: 1;
  }
</style>
