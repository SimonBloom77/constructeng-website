---
import AppBanner from '../components/AppBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import settings from '../data/settings.json';

// Google Analytics, on the live site only, once a measurement ID is set.
const gaId = String((settings as { gaId?: string }).gaId || '').trim();
const analytics = import.meta.env.PROD && /^G-[A-Z0-9]+$/.test(gaId);

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "ConstructEng Australia specialises in the recruitment of technical staff within construction and engineering, across Australia's largest building and civil developments.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | ConstructEng Australia</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..900&family=Public+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {analytics && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {analytics && (
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    )}
  </head>
  <body>
    <AppBanner />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Every mention of STARselect shows as the wordmark: bold, with "select" in gold.
      (function () {
        var skip = 'script,style,textarea,option,title,svg,.ss-wm,[contenteditable]';
        var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
          acceptNode: function (n) {
            return n.nodeValue.indexOf('STARselect') >= 0 && !(n.parentElement && n.parentElement.closest(skip))
              ? NodeFilter.FILTER_ACCEPT
              : NodeFilter.FILTER_REJECT;
          },
        });
        var hits = [];
        while (walker.nextNode()) hits.push(walker.currentNode);
        hits.forEach(function (n) {
          var parts = n.nodeValue.split('STARselect');
          var frag = document.createDocumentFragment();
          parts.forEach(function (p, i) {
            if (i) {
              var s = document.createElement('span');
              s.className = 'ss-wm';
              s.innerHTML = 'STAR<i>select</i>';
              frag.appendChild(s);
            }
            if (p) frag.appendChild(document.createTextNode(p));
          });
          var par = n.parentNode;
          par.replaceChild(frag, n);
          // In a button laid out in pieces, keep the words around the name together.
          if (par.nodeType === 1 && /flex|grid/.test(getComputedStyle(par).display)) {
            var run = [];
            var flush = function () {
              if (run.length > 1) {
                var w = document.createElement("span");
                run[0].parentNode.insertBefore(w, run[0]);
                run.forEach(function (k) { w.appendChild(k); });
              }
              run = [];
            };
            Array.prototype.slice.call(par.childNodes).forEach(function (k) {
              if (k.nodeType === 3 || (k.nodeType === 1 && k.classList.contains("ss-wm"))) run.push(k);
              else flush();
            });
            flush();
          }
        });
      })();
    </script>
    <script>
      const targets = document.querySelectorAll('main .section > .wrap > *');
      if ('IntersectionObserver' in window && targets.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
